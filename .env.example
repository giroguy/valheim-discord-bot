# Copy this file to .env and fill in real values.
# Compose-level interpolation for docker-compose.yml itself (Docker Compose
# auto-loads this file by convention) - NOT the bot's own runtime config,
# that's valheim-bot.env (separate file, separate example).

# Host paths into your separate Valheim game server project. Defaults in
# docker-compose.yml assume a sibling-directory layout (../your-valheim-server);
# override here with absolute paths if yours isn't laid out that way.
VALHEIM_LOG_HOST_PATH=../your-valheim-server/valheim/server/logs
VALHEIM_ENV_HOST_PATH=../your-valheim-server/valheim-fullmonty.env

# Optional. Overrides the bot's own container name (defaults to
# "valheim-bot" in docker-compose.yml if unset).
BOT_CONTAINER_NAME=
