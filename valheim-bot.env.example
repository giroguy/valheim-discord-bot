# Copy this file to valheim-bot.env and fill in real values.
# valheim-bot.env is a secret (holds the bot token) - don't commit it.

# Discord bot application token: Developer Portal -> your app -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# Application/Client ID: Developer Portal -> your app -> General Information -> Application ID.
DISCORD_CLIENT_ID=

# Optional. Set to your Discord server's ID to register slash commands instantly
# (guild-scoped) instead of waiting up to an hour for global command propagation.
# Enable Developer Mode in Discord Settings -> Advanced, then right-click your
# server icon -> Copy Server ID.
DISCORD_GUILD_ID=

# Webhook URL for the channel where join/leave/version/restart messages get
# posted - same kind of URL as a WEBHOOK_URL var your game server's own env
# file might already use for its own notifications, if it has one. Create
# one via that channel's Settings -> Integrations -> Webhooks -> New Webhook
# -> Copy Webhook URL. Can point at the same channel/webhook as the game
# server's own notifications, or a different one - your call.
DISCORD_WEBHOOK_URL=

# Role allowed to run /restart. Either the role name (e.g. "dev") or its
# numeric ID both work.
ADMIN_ROLE_ID=

# Optional. Who to mention on server update/restart notifications: a role
# name, a numeric role ID, "@here", or "@everyone". Leave blank for no
# mention.
UPDATE_MENTION_ROLE_ID=

# Must match your Valheim game server's actual container_name.
VALHEIM_CONTAINER_NAME=valheim

# Path to the log file as mounted into this container - see docker-compose.yml's
# volumes entry for valheim-bot. Only change this if you also change that mount.
VALHEIM_LOG_PATH=/logs/valheim_server.log
